{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadAllObjects",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::dbx-data-public/*"
    },
    {
      "Sid": "PublicBucketLocation",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::dbx-data-public"
    },
    {
      "Sid": "PublicListAirbnbSfPrefixOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::dbx-data-public",
      "Condition": {
        "StringLike": { "s3:prefix": ["airbnb-sf", "airbnb-sf/", "airbnb-sf/*"] }
      }
    }
  ]
}
